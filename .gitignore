# ── Runtime / transient artifacts (never commit) ─────────────────────────────
bob-the-tester.db
*.db-shm
*.db-wal

# Coverage
coverage.xml
.coverage
.coverage.*
htmlcov/

# pytest / JUnit
junit_*.xml
cov_*.xml
smoke_cov_*.xml
.pytest_cache/

# mutmut
.mutmut-cache
html/

# Atheris fuzz corpora and crashing inputs written by run_fuzz
fuzz_corpus/
crash-*/
fuzz_crashes/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.venv/

# Env
.env
bob-the-tester.json

# Editor
.vscode/
.idea/
*.swp
*~

# Replay snapshot — generated by rehearsing the demo, kept out of git.
# Every entry is a recorded tool result, so it is reproducible by running the
# pipeline again; a stale or half-good snapshot committed here is worse than
# none, because replay would serve it as though it were fresh.
demo_replay/

# ── Curated exceptions (DO commit these) ─────────────────────────────────────
# bob_sessions/  ← append-only; commit after every meaningful session (P3)
!bob_sessions/

# Dashboard build output (regenerate with: python -m dashboard.build)
dashboard/dist/

# MCP server log (BOB_THE_TESTER_LOG overrides the location)
logs/
