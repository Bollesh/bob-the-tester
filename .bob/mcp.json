      "command": "/run/media/bolleshjonathan/New Volume/BOB/bob-the-tester/.venv/bin/python",
      "args": [
        "-m",
        "server.main"
      ],
      "env": {
        "PYTHONPATH": "/run/media/bolleshjonathan/New Volume/BOB/bob-the-tester",
        "BOB_THE_TESTER_REPLAY": "0"
      }
    },
    "context7": {
      "command": "npx",
