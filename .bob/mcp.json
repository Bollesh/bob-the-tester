{
  "mcpServers": {
    "bob-the-tester": {
      "command": "${workspaceFolder}/scripts/mcp_server.sh",
      "env": {
        "BOB_THE_TESTER_REPLAY": "0"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@^2.2.0"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
