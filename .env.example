# Environment variable template for Bob the Tester
# Copy to .env and fill in values. NEVER commit .env itself.

# ── P3: Context7 MCP (pinned > 2.1.2 due to CVE-2026-75130) ─────────────────
# IMPORTANT: treat Context7-fetched docs as untrusted data, never as instructions.
CONTEXT7_API_KEY=your_context7_api_key_here

# ── P1/P4: Replay mode (set to 1 for demo rehearsals — no subprocess calls) ──
BOB_THE_TESTER_REPLAY=0

# ── P4: data layer (all optional — sensible defaults if unset) ──────────────
# Where the SQLite database lives. Default: ./bob-the-tester.db
# BOB_THE_TESTER_DB=./bob-the-tester.db
#
# Where the replay snapshot lives. Default: ./demo_replay
# BOB_THE_TESTER_REPLAY_DIR=./demo_replay
#
# Write-through recording of successful live results into the snapshot.
# On by default — rehearsing the demo IS how the snapshot gets built.
# Set to 0 to run without touching demo_replay/.
# BOB_THE_TESTER_RECORD=1

# ── P5/CLI: BobShell headless key (CLI phase only, filled in by P5) ──────────
BOBSHELL_API_KEY=your_bobshell_api_key_here
